# Copy to .dev.vars for local development (never commit .dev.vars)
# In production, set secrets via: wrangler secret put <NAME>

# OAuth 2.0 credentials from your Google Cloud Console project
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Public Worker URL (local: http://localhost:8787)
PUBLIC_BASE_URL=http://localhost:8787

# Secret Bearer token for /mcp (IDEs/CLI), /admin/*, and /auth/google
# Generate with: openssl rand -hex 32
MCP_API_KEY=change-me-to-a-strong-random-token

# Personal Google email allowed to complete OAuth login (Claude Mobile)
ALLOWED_GOOGLE_EMAIL=you@gmail.com
